{
  "manifest_version": 3,
  "minimum_chrome_version": "91",
  "name": "Bangla Phonetic Pronunciation",
  "version": "1.0.4",
  "description": "Ctrl দিয়ে English pronunciation এবং Alt দিয়ে বাংলা অর্থ দেখুন।",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Bangla Phonetic Pronunciation",
    "default_popup": "options.html"
  },
  "options_page": "options.html"
}
